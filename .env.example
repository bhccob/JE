# This site is a concept redesign: it shows a notice saying so, stays out of search engines, and the quote form sends
# nothing. Set this to 1 only if the store's owner adopts it as the official Jontai Energy site.
NEXT_PUBLIC_OFFICIAL_SITE=

# Quote requests (/quote) are emailed to the store through Resend (https://resend.com).
# Without these the quote page still works: it offers to send the request from the visitor's own email app.
RESEND_API_KEY=
# An address on a domain verified in Resend, for example: Jontai Energy website <quotes@your-domain.com>
QUOTE_FROM=
# Where requests go. Defaults to the store email in lib/store.ts (jontai@qq.com).
QUOTE_TO=
